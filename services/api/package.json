{
  "name": "@bizflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "BizFlow Express API service — Phase 2",
  "type": "commonjs",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bizflow/auth": "*",
    "@bizflow/database": "*",
    "@bizflow/validation": "*",
    "express": "^5.3.0",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "express-rate-limit": "^7.5.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "supertest": "^7.1.0",
    "@types/supertest": "^7.2.1",
    "tsx": "^4.19.4",
    "typescript": "*",
    "vitest": "^4.1.12"
  }
}
