# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bizflow_dev
POSTGRES_USER=bizflow
POSTGRES_PASSWORD=change_me_in_local_only

# Full Prisma connection URL (built from above vars)
DATABASE_URL=postgresql://bizflow:change_me_in_local_only@localhost:5432/bizflow_dev

# ─── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_local_only

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── Firebase Admin SDK (server-side only — NEVER put these in the browser) ──
# FIREBASE_PROJECT_ID=your-firebase-project-id
# One of the following credential strategies must be configured:
#   Option A: Service account JSON as a string (recommended for CI/CD)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#   Option B: GOOGLE_APPLICATION_CREDENTIALS path (for GCP and local dev)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Firebase CLIENT SDK (safe for browser — these are public values) ─────────
# These identify your Firebase project but grant no admin access.
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ─── AI / LLM (Phase 3 — not yet implemented) ────────────────────────────────
# OPENAI_API_KEY=sk-replace_with_real_key
# ANTHROPIC_API_KEY=sk-ant-replace_with_real_key

# ─── Email (Phase 4 — not yet implemented) ───────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=replace_with_real_password

# ─── Storage (Phase 4 — not yet implemented) ─────────────────────────────────
# AWS_ACCESS_KEY_ID=replace_with_real_key
# AWS_SECRET_ACCESS_KEY=replace_with_real_secret
# AWS_REGION=ap-south-1
# S3_BUCKET=bizflow-dev-bucket

# NOTE: This file contains ONLY placeholder values. Never commit real secrets.
# Copy this to .env and fill in real values for local development only.
# Production credentials must be injected via a secrets manager (e.g., Doppler,
# AWS Secrets Manager, GCP Secret Manager) — never stored in source control.
